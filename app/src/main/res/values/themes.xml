<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mossling" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/chalk</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Mossling.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/chalk</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.Mossling</item>
    </style>
</resources>
