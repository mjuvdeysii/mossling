	<key>NSMotionUsageDescription</key><string>在床头夜灯和金珠雨声棒中，感受手机轻倾以呈现柔和光影与木珠滚动。</string>
	<key>NSPhotoLibraryUsageDescription</key><string>为「第一次」挑选纪念照片，照片仅保存在这台手机上，不会上传。</string>
	<key>NSSupportsLiveActivities</key><true/>
	<key>UILaunchScreen</key>
	<dict><key>UIColorName</key><string>Chalk</string></dict>
	<key>UIApplicationSceneManifest</key>
	<dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
	<key>UIRequiresFullScreen</key><true/>
	<key>UIBackgroundModes</key>
	<array><string>audio</string></array>
	<key>UISupportedInterfaceOrientations</key>
	<array><string>UIInterfaceOrientationPortrait</string></array>
	<key>CFBundleURLTypes</key>
	<array><dict><key>CFBundleURLName</key><string>app.mossling</string><key>CFBundleURLSchemes</key><array><string>mossling</string></array></dict></array>
	<key>UIFileSharingEnabled</key><true/>
	<key>LSSupportsOpeningDocumentsInPlace</key><true/>
	<key>MosslingICP</key><string>$(MOSSLING_ICP)</string>
	<key>MosslingDeveloper</key><string>$(MOSSLING_DEVELOPER)</string>
	<key>MosslingEmail</key><string>$(MOSSLING_EMAIL)</string>
	<key>MosslingWebsite</key><string>$(MOSSLING_WEBSITE)</string>
	<key>CFBundleLocalizations</key><array><string>zh-Hans</string><string>en</string></array>
