    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlock Moss & Otto to protect your baby's local records."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于解锁摸索台灯，保护宝宝的本地记录。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record short baby voice keepsakes for Firsts and Quotes. Audio stays strictly on this iPhone and is never uploaded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为「第一次」与「童言一句」录制宝宝的小声音，音频仅保存在这台手机本地，不会上传。"
          }
        }
      }
    },
    "NSMotionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gently sways Otto's bedside lamp glow and rolls Montessori rainstick beads when you tilt your iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在床头夜灯和金珠雨声棒中，感受手机轻倾以呈现柔和光影与木珠滚动。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save collector wallpapers, growth prints, and handover cards to your Photo Library."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存藏画壁纸、成长印画与照护交接卡片到系统相册。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose keepsake photos for Firsts and food stickers for First Foods. Photos stay strictly on this iPhone and are never uploaded."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为「第一次」与「百味食盒」挑选纪念照片与辅食贴纸，照片仅保存在这台手机上，不会上传。"
          }
        }
      }
    }
  },
  "version" : "1.0"
